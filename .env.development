# Development Environment Variables
# Prefer EXPO_PUBLIC_* so values are available in the Expo client bundle.
# NOTE: For Android/iOS physical devices, localhost will NOT work.
# Set this to your PC LAN IP (same Wi‑Fi), e.g. http://192.168.1.5:5000/api
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
# EXPO_PUBLIC_WS_URL=ws://localhost:5000

ENVIRONMENT=development

